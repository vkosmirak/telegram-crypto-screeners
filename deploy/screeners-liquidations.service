# Record liquidation feeds. They cannot be backfilled, so this wants to have
# been running for weeks before the liquidation screener means anything.
#   sudo cp deploy/*.service /etc/systemd/system/
#   sudo systemctl enable --now screeners-liquidations
[Unit]
Description=screeners liquidation recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-crypto-screeners
Environment=PYTHONPATH=/opt/telegram-crypto-screeners/src
ExecStart=/usr/bin/python3 -m screeners.cli record-liquidations --exchange both
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
