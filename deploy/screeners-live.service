# Live screener. Runs as its own unit, separate from the recorder, so a wedged
# Telegram send can never stall liquidation ingest.
[Unit]
Description=screeners live screener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-crypto-screeners
Environment=PYTHONPATH=/opt/telegram-crypto-screeners/src
ExecStart=/usr/bin/python3 -m screeners.cli live --exchange binance --rules oi_growth,pump_short
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
