# Copy to .env (chmod 600). Nothing here is needed for backtesting --
# only the live screener and its alerts read these.

# ── Telegram ──────────────────────────────────────────────────────────────────
# This repo uses its OWN bot, not telegram-copy-trading's. Make one with
# @BotFather, add it to a forum-enabled supergroup as admin, then read the
# chat id and topic ids off the group (see README).
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# Forum topic ids -- one topic per screener, so signals stay separable.
TOPIC_OI=
TOPIC_PUMP=
TOPIC_LIQUIDATION=
TOPIC_OPS=              # health / errors / startup

LOG_LEVEL=INFO
